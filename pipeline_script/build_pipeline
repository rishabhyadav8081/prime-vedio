pipeline {
    agent any
    
    parameters {
        string(name: 'ECR_REPO_NAME', defaultValue: 'amazon-prime', description: 'enter the repo name')
         string(name: 'AWS_ACCOUNT_ID', defaultValue: '516525145025', description: 'enter the awd account id')
    }
    environment {
        SCANNER_HOME = tool 'SonarQube Scanner'
    }
    
    stages {
        stage('Clean Workspace') {
           steps {
               cleanWs()
               }
          }
        stage('Git Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/rishabhyadav8081/prime-vedio.git'
            }
        }
        stage('Check Commit') {
    steps {
        script {
            def commitMessage = sh(
                script: 'git log -1 --pretty=%B',
                returnStdout: true
            ).trim()

            if (commitMessage.startsWith('JENKINS:')) {
                echo "Jenkins-generated commit detected. Skipping pipeline."
                currentBuild.result = 'NOT_BUILT'
                error('Skipping Jenkins-generated commit')
            }
        }
    }
}
       
          stage('NPM install') {
            steps {
                sh 'npm install'
               }
          }
          stage('TRIVY Scan') {
            steps {
                sh 'trivy fs . > trivy-scan.txt'
               }
          }
           stage('Docker Build') {
            steps {
                sh "docker build -t ${params.ECR_REPO_NAME} ."
               }
          }
          stage('Create ECR Repo') {
            steps {
               withCredentials([string(credentialsId: 'access-key', variable: 'AWS_ACCESS_KEY'), string(credentialsId: 'secret-key', variable: 'AWS_SECRET_KEY')]) {
                  sh """  
                  aws configure set aws_access_key_id $AWS_ACCESS_KEY
                  aws configure set aws_secret_access_key $AWS_SECRET_KEY
                  aws ecr describe-repositories --repository-names ${params.ECR_REPO_NAME} --region us-east-1 || \
                  aws ecr create-repository --repository-name ${params.ECR_REPO_NAME} --region us-east-1
                  """
                }
               }
          }
          stage('Image Tag and push') {
            steps {
                withCredentials([string(credentialsId: 'access-key', variable: 'AWS_ACCESS_KEY'), string(credentialsId: 'secret-key', variable: 'AWS_SECRET_KEY')]) {
                  sh """  
                  aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin ${params.AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com
                  docker tag ${params.ECR_REPO_NAME} ${params.AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/${params.ECR_REPO_NAME}:$BUILD_NUMBER
                  docker push ${params.AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/${params.ECR_REPO_NAME}:$BUILD_NUMBER
                 """
                }
               }
          }
           stage('Delete image from jenkins ') {
            steps {
                withCredentials([string(credentialsId: 'access-key', variable: 'AWS_ACCESS_KEY'), string(credentialsId: 'secret-key', variable: 'AWS_SECRET_KEY')]) {
                  sh """  
                  docker rmi ${params.AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/${params.ECR_REPO_NAME}:$BUILD_NUMBER
                 """
                }
               }
          }
          stage('Update K8s Manifest') {
           steps {
        withCredentials([usernamePassword(
            credentialsId: 'github-credentials',
            usernameVariable: 'GITHUB_USER',
            passwordVariable: 'GITHUB_TOKEN'
        )]) {
            sh '''
                git clone https://${GITHUB_USER}:${GITHUB_TOKEN}@github.com/rishabhyadav8081/prime-vedio.git

                cd k8s_files

                sed -i "s|image: .*|image: ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/${ECR_REPO_NAME}:${BUILD_NUMBER}|" deployment.yaml

                git config user.name "Jenkins"
                git config user.email "jenkins@example.com"

                git add deployment.yaml
                git commit -m "Update image to ${BUILD_NUMBER}"
                
                 git remote set-url origin https://rishabhyadav8081:${GITHUB_TOKEN}@github.com/rishabhyadav8081/prime-vedio.git
                git push origin main
            '''
        }
    }
}
    }
}
